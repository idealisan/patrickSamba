#!/bin/sh
pkill -f /tmp/stupidsamba 2>/dev/null
sleep 0.5
/tmp/stupidsamba -config /tmp/smbtest/cfg.yaml > /tmp/smbtest/srv.log 2>&1 &
SRV=$!
sleep 1
WORK=/tmp/smbtest
smbclient "//127.0.0.1/public" -p 4555 -U testuser%testpass123 -m SMB3 -c '
    ls
    get hello.txt '"$WORK"'/got-hello.txt
    put '"$WORK"'/cfg.yaml uploaded.yaml
    mkdir newdir
    cd subdir
    ls
    cd ..
    rename uploaded.yaml renamed.yaml
    rm renamed.yaml
    rmdir newdir
' > /tmp/smbtest/cli.out 2>&1
echo "smbclient rc=$?"
echo "=== cli.out ==="
cat /tmp/smbtest/cli.out
echo "=== got-hello ==="
cat /tmp/smbtest/got-hello.txt 2>&1
echo "=== srv log tail ==="
tail -20 /tmp/smbtest/srv.log
kill $SRV 2>/dev/null
