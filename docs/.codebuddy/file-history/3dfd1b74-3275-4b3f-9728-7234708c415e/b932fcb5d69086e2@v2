#!/bin/sh
pkill -f /tmp/stupidsamba 2>/dev/null
sleep 0.5
/tmp/stupidsamba -config /tmp/smbtest/cfg.yaml > /tmp/smbtest/srv.log 2>&1 &
SRV=$!
sleep 1
run() { timeout 20 smbclient "$@" > "$1" 2>&1; echo "rc=$? (cmd: ${*:2})"; cat "$1"; echo; }

echo "########## 1) baseline ls ##########"
timeout 20 smbclient "//127.0.0.1/public" -p 4555 -U testuser%testpass123 -m SMB3 -c 'ls' > /tmp/smbtest/o1 2>&1
echo "ls rc=$?"; cat /tmp/smbtest/o1; echo

echo "########## 2) share enumeration smbclient -L ##########"
timeout 20 smbclient -L //127.0.0.1 -p 4555 -U testuser%testpass123 -m SMB3 > /tmp/smbtest/o2 2>&1
echo "-L rc=$?"; cat /tmp/smbtest/o2; echo

echo "########## 3) encryption required smbclient -e ##########"
timeout 20 smbclient "//127.0.0.1/public" -p 4555 -U testuser%testpass123 -m SMB3 -e -c 'ls' > /tmp/smbtest/o3 2>&1
echo "-e ls rc=$?"; cat /tmp/smbtest/o3; echo

echo "########## 4) server log tail ##########"
tail -20 /tmp/smbtest/srv.log
kill $SRV 2>/dev/null
